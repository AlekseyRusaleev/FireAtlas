[Unit]
Description=FireAtlas housenumbers API (Nominatim)
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=infocard
WorkingDirectory=/home/infocard/fireatlas-geocoder-sfo/housenumbers
ExecStart=/usr/bin/python3 /home/infocard/fireatlas-geocoder-sfo/housenumbers/housenumbers_api.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
