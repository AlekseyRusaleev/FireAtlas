{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Пожарный Атлас",
  "version": "0.1.20",
  "identifier": "ru.fireatlas.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/copy-webview2-loader.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Пожарный Атлас",
        "width": 1400,
        "height": 900,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128-2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
